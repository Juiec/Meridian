# OpenAI-compatible base URL for LM Studio.
# Include /v1. A Tailscale MagicDNS URL looks like:
#   http://hostname.tailnet-name.ts.net:1234/v1
# If the path is empty, Meridian appends /v1.
LM_STUDIO_BASE_URL=http://hostname.tailnet-name.ts.net:1234/v1

# Optional. Leave blank when LM Studio has no API key.
# Saved settings in data/settings.json override this and are not committed.
LM_STUDIO_API_KEY=

# Model id as listed by GET /v1/models. New sessions copy this unless you set one per chat.
MODEL=

# Optional. Docker Compose reads this file when it is named .env.
# From inside Compose, a server on the host is http://host.docker.internal:1234/v1
# A Tailscale MagicDNS name works when the container's network can resolve it.
# Meridian does not run Tailscale itself.

# MCP environment variables and custom-tool header secrets are not set here.
# They are saved in data/mcp-servers.json and data/custom-tools.json (gitignored with data/).
# The settings API returns key names only, never those values.

# Optional fare search. Leave both blank to use illustrative distance quotes (not live fares).
# Meridian POSTs { from, to, date, passengers } and does not book or take payment.
# A saved value in data/travel-settings.json overrides these. The key is never sent to the browser.
# Private and loopback URLs are refused. Point a custom tool at a server on this machine instead.
# TRAVEL_PRICE_URL=https://example.com/fares
# TRAVEL_PRICE_API_KEY=
