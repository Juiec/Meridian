# Bootstrap for the default endpoint, used only until you save Settings.
# Local dev: copy this file to .env.local (Next.js reads it).
# Docker Compose: copy this file to .env (Compose reads that name).
#
# Saved profiles (name, URL, model) live in data/endpoints.json.
# API keys live in data/secrets/endpoints.json, mode 0600, and are never written into the profile file.
# A saved profile wins over these variables. data/ is gitignored.

# OpenAI-compatible base URL, including /v1. Meridian appends /v1 when the path is empty.
# A server on this machine:
#   LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# From inside Compose, a server on the host is http://host.docker.internal:1234/v1
# The Compose sidecar joins your tailnet, so a MagicDNS name resolves, for example
#   http://studio.tailnet-name.ts.net:1234/v1
# LM_STUDIO_BASE_URL=

# Optional bearer token. Leave unset when the server has no API key.
# LM_STUDIO_API_KEY=

# Model id as listed by GET /v1/models. New sessions copy this unless you set one per chat.
# MODEL=

# MCP environment variables and custom-tool header secrets are not set here.
# They are saved in data/mcp-servers.json and data/custom-tools.json (gitignored with data/).
# The settings API returns key names only, never those values.

# Optional fare search. Leave both unset to use illustrative distance quotes (not live fares).
# Meridian POSTs { from, to, date, passengers } and does not book or take payment.
# A saved value in data/travel-settings.json overrides these. The key is never sent to the browser.
# Private and loopback URLs are refused. Point a custom tool at a server on this machine instead.
# TRAVEL_PRICE_URL=https://example.com/fares
# TRAVEL_PRICE_API_KEY=

# Auth key for the Tailscale sidecar in docker-compose.yml. Compose reads this from .env.
# Generate a reusable, pre-approved, tagged key in the Tailscale admin console.
# Leave it unset for npm run dev. An empty key leaves the sidecar logged out.
# TS_AUTHKEY=tskey-auth-...
